# Copy to .env and fill in. Never commit .env or key files.

# prod | demo   (demo = https://demo.kalshi.co paper environment with fake money)
KALSHI_ENV=demo

# From https://kalshi.com/account/profile (API keys). Optional: public market data works without keys,
# but the WebSocket feed, orderbook endpoint and any order placement require them.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=./kalshi-private-key.pem

# Polymarket is read-only for now (Gamma + CLOB public endpoints need no auth).

# Logging: e.g. info, or mbot=debug,mb_kalshi=trace
RUST_LOG=info
